# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: leave DB_ENGINE empty for SQLite, or set to postgres
DB_ENGINE=
DB_NAME=fxcompass
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Data sources (no API keys needed)
FRANKFURTER_URL=https://api.frankfurter.dev/v1
AED_LIVE_URL=https://open.er-api.com/v6/latest/EUR
HISTORY_START=2018-01-01
REFRESH_AFTER_HOURS=6

# Frontend (Vite) – where the Django API lives
VITE_API_URL=http://localhost:8000/api
